{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clipboard-formatter",
  "title": "Clipboard Formatter",
  "description": "Removes formatting and html from the text stored in the clipboard, returning the unformatted text to the clipboard.",
  "icon": "assets/extension_icon.png",
  "author": "almatkai",
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Strip Clipboard Formatting",
      "description": "Removes formatting and html from the text stored in the clipboard, returning the unformatted text to the clipboard.",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.clipboard-formatter",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/clipboard-formatter",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/clipboard-formatter",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
